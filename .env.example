# Адрес Ollama (по умолчанию локальный)
OLLAMA_BASE_URL=http://localhost:11434
# Модель Qwen3: qwen3:1.7b / qwen3:4b / qwen3:8b / qwen3:14b
OLLAMA_MODEL=qwen3:4b
# Таймаут одного запроса, мс (на CPU запросы долгие)
LLM_TIMEOUT_MS=300000
# Сколько раз повторять запрос, если результат не прошёл проверки
LLM_MAX_RETRIES=2
# Размер контекста (у товаров с длинным списком характеристик 4096 может не хватить)
OLLAMA_NUM_CTX=8192
# Уровень журнала в stderr: debug | info | warn | error | silent
LOG_LEVEL=info
